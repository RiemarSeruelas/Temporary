# Browser URL: http://localhost:5059
APP_PORT=5059

# PostgreSQL container
POSTGRES_DB=mespack
POSTGRES_USER=mespack
POSTGRES_PASSWORD=replace-this-database-password

# Admin login
ADMIN_PASSWORD=replace-this-admin-password

# MQTT / HighByte
# Example if your MQTT broker runs on the Docker host:
# MQTT_BROKER=mqtt://host.docker.internal:1883
MQTT_BROKER=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=sensor/data

# Face recognition service, if used
FACE_API_BASE_URL=
APP_NAMESPACE=machine_dashboard

LOG_LEVEL=minimal
MACHINE_DATA_STALE_SECONDS=300
